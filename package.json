{
  "name": "jam-vibes",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate:openapi && next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prettier": "prettier --check \"**/*.{js,jsx,ts,tsx}\"",
    "prettier:fix": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "generate:openapi": "tsx scripts/generate-openapi.ts",
    "supabase:start": "supabase start --workdir ./lib -x studio,postgres-meta,imgproxy,edge-runtime,vector",
    "supabase:start:studio": "supabase start --workdir ./lib -x imgproxy,edge-runtime,vector",
    "supabase:stop": "supabase stop --workdir ./lib",
    "supabase:status": "supabase status --workdir ./lib",
    "supabase:db:reset": "supabase db reset --workdir ./lib",
    "supabase:db:diff": "supabase db diff --workdir ./lib",
    "supabase:db:push": "supabase db push --workdir ./lib",
    "review:pr": "scripts/review-pr.sh",
    "review:done": "scripts/review-done.sh",
    "test:unit": "vitest run app lib components",
    "test:acceptance": "vitest run --testTimeout=15000 __test__/acceptance/tests",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "precommit": "time (npm run lint:fix && npm run prettier:fix && npm run test:unit && npm run test:acceptance && npm run test:smoke)"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-avatar": "^1.1.12",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-slider": "^1.4.0",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-tabs": "^1.1.14",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.1",
    "@wavesurfer/react": "^1.0.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "pino": "^10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.78.0",
    "swagger-ui-react": "^5.32.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "unique-names-generator": "^4.7.1",
    "wavesurfer.js": "^7.12.7",
    "zod": "^4.4.3",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/swagger-ui-react": "^5.18.0",
    "@vitejs/plugin-react": "^6.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "15.1.2",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^28.1.0",
    "postcss": "^8",
    "prettier": "^3.8.4",
    "supabase": "^2.105.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.8"
  }
}
